# FastAPI backend
APP_HOST=0.0.0.0
APP_PORT=8080
UPLOAD_DIR=app/uploads
MAX_UPLOAD_MB=512
MAX_HISTORY_TURNS=12

# VLM service (OpenAI-compatible, e.g. vLLM)
VLM_API_BASE=http://127.0.0.1:8000/v1
VLM_API_KEY=
VLM_MODEL=huang01080524/lungct-nodule-grpo
VLM_TIMEOUT_SECONDS=120
VLM_MAX_TOKENS=800
VLM_TEMPERATURE=0

# Development fallback. Set true to test UI/API without a running VLM.
VLM_MOCK=false

# Optional detector. Manual coordinates are the default path.
DETECTOR_BACKEND=disabled
# Example command contract: command receives CT path as argv[-1] and prints JSON list:
# [{"x": 12.3, "y": -45.2, "z": -120.5, "diameter_mm": 8.6, "confidence": 0.95}]
DETECTOR_COMMAND=
DETECTOR_TIMEOUT_SECONDS=60

# Agent web search
TAVILY_API_KEY=
